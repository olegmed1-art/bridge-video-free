+"""Offline post-admission retry boundaries; no admission or live queue is run.
+
+Exercise the real checkpoint and result lookup against synthetic Drive storage.
+The transaction tests exercise the Python adapter, not PostgreSQL lease fencing.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import re
+import socket
+import subprocess
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import psycopg
+import pytest
+import requests
+
+import transcript_stage_checkpoint_v1 as checkpoint
+from bridge_output_scoped_idempotency import existing_same_revision_done
+from universal_video import video_queue
+
+
+REVISION = "3.1-free-r25.15"  # Transcript stage inherited by the r25.16 worker.
+RESULT_REVISION = "3.1-free-r25.16"
+SEGMENTS = [{"start": 0.0, "end": 1.0, "text": "synthetic bridge lesson"}]
+
+
+@pytest.fixture(autouse=True)
+def offline(monkeypatch):
+    forbidden = Mock(side_effect=AssertionError("external side effect in offline test"))
+    for owner, name in (
+        (socket, "create_connection"), (socket.socket, "connect"),
+        (requests.sessions.Session, "request"), (subprocess, "Popen"),
+        (psycopg, "connect"),
+    ):
+        monkeypatch.setattr(owner, name, forbidden)
+    yield
+    forbidden.assert_not_called()
+
+
+@pytest.fixture
+def stage(tmp_path, monkeypatch):
+    monkeypatch.setenv("BRIDGE_WORK_FOLDER_ID", "synthetic-work")
+    monkeypatch.setenv("BRIDGE_OUTPUT_FOLDER_ID", "synthetic-output")
+    monkeypatch.setenv("BRIDGE_ORIGINAL_SOURCE_DRIVE_ID", "synthetic-source-1")
+    records = {}
+
+    def upload(_token, folder, name, payload):
+        item_id = f"record-{len(records) + 1}"
+        records[item_id] = {
+            "id": item_id, "folder": folder, "name": name,
+            "body": json.dumps(payload),
+        }
+        return {"id": item_id}
+
+    def search(_token, query):
+        folder = re.search(r"'([^']+)' in parents", query).group(1)
+        name = re.search(r"name='([^']+)'", query).group(1)
+        return [dict(item) for item in records.values()
+                if item["folder"] == folder and item["name"] == name]
+
+    io = SimpleNamespace(
+        search=Mock(side_effect=search), upload_json=Mock(side_effect=upload),
+        sha=lambda path: hashlib.sha256(path.read_bytes()).hexdigest(), safe=Mock(),
+    )
+    compute = Mock(side_effect=lambda *args: (copy.deepcopy(SEGMENTS), {"qc": "PASS"}, []))
+
+    def fresh_worker():
+        monkeypatch.setattr(checkpoint, "_INSTALLED", False)
+        base = SimpleNamespace(io=io, obtain_transcript=compute,
+                               _read_text=lambda _token, item: records[item["id"]]["body"])
+        checkpoint.install(base, REVISION)
+        return base
+
+    video = tmp_path / "source.mp4"
+    video.write_bytes(b"synthetic source bytes, never decoded")
+    return SimpleNamespace(base=fresh_worker(), restart=fresh_worker, video=video,
+                           records=records, io=io, compute=compute, upload=upload)
+
+
+def obtain(stage, job="job-1"):
+    return stage.base.obtain_transcript("synthetic-token", "source-folder", "source.mp4",
+                                        stage.video, stage.video.parent, 2.0, job)
+
+
+@pytest.mark.parametrize("boundary", ["before_checkpoint", "after_checkpoint", "after_result"])
+def test_bounded_batch_resumes_saved_stage_and_reuses_terminal_result(stage, monkeypatch, boundary):
+    # Two already-admitted identities; this test neither admits nor releases jobs.
+    batch = ("job-1", "job-2")
+
+    def attempt(job):
+        semantic = SimpleNamespace(base=stage.base)
+        done = existing_same_revision_done(semantic, "synthetic-token", job, RESULT_REVISION)
+        if done is not None:
+            return done
+        obtain(stage, job)
+        done = {"status": "AI_DONE", "job_id": job, "algorithmRevision": RESULT_REVISION,
+                "masterPdf": {"driveId": f"synthetic-pdf-{job}"}}
+        stage.io.upload_json("synthetic-token", "synthetic-output", f"AI_DONE_{job}.json", done)
+        stage.io.upload_json("synthetic-token", "synthetic-output", f"METHODOLOGY_READY_{job}.json",
+                             {"status": "METHODOLOGY_READY", "job_id": job,
+                              "algorithmRevision": RESULT_REVISION,
+                              "masterPdfDriveId": done["masterPdf"]["driveId"]})
+        return done
+
+    def interrupted_upload(token, folder, name, payload):
+        at_checkpoint = name.startswith("TRANSCRIPT_STAGE_CHECKPOINT_")
+        if boundary == "before_checkpoint" and at_checkpoint:
+            raise SystemExit("synthetic crash before checkpoint write")
+        receipt = stage.upload(token, folder, name, payload)
+        if (boundary == "after_checkpoint" and at_checkpoint) or (
+            boundary == "after_result" and name.startswith("METHODOLOGY_READY_")
+        ):
+            raise SystemExit("synthetic crash after durable write, before acknowledgement")
+        return receipt
+
+    stage.io.upload_json.side_effect = interrupted_upload
+    with pytest.raises(SystemExit, match="synthetic crash"):
+        attempt(batch[0])
+    assert stage.compute.call_count == 1
+    saved_bytes = {key: item["body"] for key, item in stage.records.items()}
+    stage.io.upload_json.side_effect = stage.upload
+    stage.base = stage.restart()  # Lose worker memory; retain only synthetic service records.
+    first_result = attempt(batch[0])
+    assert stage.compute.call_count == (2 if boundary == "before_checkpoint" else 1)
+    assert all(stage.records[key]["body"] == body for key, body in saved_bytes.items())
+    monkeypatch.setenv("BRIDGE_ORIGINAL_SOURCE_DRIVE_ID", "synthetic-source-2")
+    second_result = attempt(batch[1])
+    calls = (stage.compute.call_count, stage.io.upload_json.call_count)
+    assert attempt(batch[1]) == second_result
+    monkeypatch.setenv("BRIDGE_ORIGINAL_SOURCE_DRIVE_ID", "synthetic-source-1")
+    assert attempt(batch[0]) == first_result
+    assert (stage.compute.call_count, stage.io.upload_json.call_count) == calls
+    assert stage.compute.call_count == (3 if boundary == "before_checkpoint" else 2)
+    for prefix in ("TRANSCRIPT_STAGE_CHECKPOINT_", "AI_DONE_", "METHODOLOGY_READY_"):
+        assert sum(item["name"].startswith(prefix) for item in stage.records.values()) == len(batch)
+
+
+@pytest.mark.parametrize("change", [
+    {"sourceDriveId": None}, {"sourceDriveId": ""}, {"sourceDriveId": "different-source"},
+    {"sourceSha256": "a" * 64}, {"algorithmRevision": "other-revision"},
+    {"job_id": "other-job"}, {"status": "IN_PROGRESS"},
+    {"durationSeconds": float("nan")}, {"durationSeconds": float("inf")},
+    {"durationSeconds": 3.0},
+    {"segments": [{"start": float("nan"), "end": 1.0, "text": "invalid"}]},
+    {"segments": [{"start": 0.0, "end": float("inf"), "text": "invalid"}]},
+])
+def test_retry_recomputes_untrusted_checkpoint_instead_of_accepting_it(stage, change):
+    obtain(stage)
+    record = next(iter(stage.records.values()))
+    payload = json.loads(record["body"])
+    payload.update(change)
+    record["body"] = json.dumps(payload)
+    preserved = record["body"]
+    stage.base = stage.restart()
+    segments, info, _warnings = obtain(stage)
+    assert stage.compute.call_count == 2
+    assert segments == SEGMENTS
+    assert info["transcriptStageCheckpoint"]["status"] == "CREATED"
+    assert record["body"] == preserved  # Invalid evidence remains available for diagnosis.
+
+
+def test_retry_reuses_checkpoint_without_mutating_saved_evidence(stage):
+    obtain(stage)
+    saved = copy.deepcopy(stage.records)
+    stage.base = stage.restart()
+    segments, info, warnings = obtain(stage)
+    assert info["transcriptStageCheckpoint"]["status"] == "REUSED"
+    segments[0]["text"] = "caller mutation"
+    info["qc"] = "caller mutation"
+    warnings.append("caller mutation")
+    again = obtain(stage)
+    assert again[0] == SEGMENTS and again[1]["qc"] == "PASS" and again[2] == []
+    assert stage.compute.call_count == 1 and stage.records == saved
+
+
+@pytest.mark.parametrize("source_id", [None, "", " "])
+def test_retry_without_current_source_identity_neither_reuses_nor_saves(stage, monkeypatch, source_id):
+    obtain(stage)
+    saved = copy.deepcopy(stage.records)
+    if source_id is None:
+        monkeypatch.delenv("BRIDGE_ORIGINAL_SOURCE_DRIVE_ID")
+    else:
+        monkeypatch.setenv("BRIDGE_ORIGINAL_SOURCE_DRIVE_ID", source_id)
+    stage.base = stage.restart()
+    segments, info, _warnings = obtain(stage)
+    assert stage.compute.call_count == 2 and segments == SEGMENTS
+    assert "transcriptStageCheckpoint" not in info
+    assert stage.records == saved and stage.io.upload_json.call_count == 1
+
+
+@pytest.mark.parametrize("duration", [float("nan"), float("inf"), float("-inf"), 0.0, -1.0])
+def test_invalid_observed_duration_is_not_saved_as_resumable_evidence(stage, duration):
+    segments, info, _warnings = stage.base.obtain_transcript(
+        "synthetic-token", "source-folder", "source.mp4", stage.video,
+        stage.video.parent, duration, "job-1",
+    )
+    assert segments == SEGMENTS and stage.compute.call_count == 1
+    assert "transcriptStageCheckpoint" not in info
+    stage.io.upload_json.assert_not_called()
+    assert stage.records == {}
+
+
+@pytest.mark.parametrize("boundary", ["before_commit", "lost_commit_reply", "success"])
+def test_finish_submits_once_and_never_reports_success_before_commit(monkeypatch, boundary):
+    # Transport double: commit ambiguity must propagate, not trigger another submission.
+    # This does NOT implement or claim to prove the server's lease/SQL state machine.
+    receipt = {"job_status": "REVIEW_READY", "batch_status": "CANARY_REVIEW", "released_jobs": 0}
+    events = []
+    cursor = Mock()
+    cursor.__enter__ = Mock(return_value=cursor)
+    cursor.__exit__ = Mock(return_value=False)
+    cursor.fetchone.side_effect = lambda: (events.append("row"), receipt)[1]
+
+    class Connection:
+        def __enter__(self):
+            return self
+
+        def cursor(self):
+            return cursor
+
+        def __exit__(self, *_args):
+            if boundary == "before_commit":
+                events.append("rollback")
+                raise ConnectionError("synthetic pre-commit failure")
+            events.append("commit")
+            if boundary == "lost_commit_reply":
+                raise ConnectionError("synthetic commit reply lost")
+
+    connect = Mock(return_value=Connection())
+    monkeypatch.setattr(psycopg, "connect", connect)
+    kwargs = dict(job_id="job-1", lease_token="lease-1", worker_key="worker-1",
+                  outcome="REVIEW_READY", output={"synthetic": True})
+    if boundary == "success":
+        assert video_queue.finish_job("postgresql://offline.invalid/db", **kwargs) == receipt
+        events.append("returned")
+        assert events == ["row", "commit", "returned"]
+    else:
+        with pytest.raises(ConnectionError, match="synthetic"):
+            video_queue.finish_job("postgresql://offline.invalid/db", **kwargs)
+        assert events == ["row", "rollback" if boundary == "before_commit" else "commit"]
+    connect.assert_called_once()
+    cursor.execute.assert_called_once()
+    statement, params = cursor.execute.call_args.args
+    assert statement == "SELECT * FROM video_queue.finish_job(%s,%s,%s,%s,%s,%s)"
+    assert params[:4] == ("job-1", "lease-1", "worker-1", "REVIEW_READY")
