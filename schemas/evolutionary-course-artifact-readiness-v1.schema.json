{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evolutionary Course real-artifact readiness manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "as_of", "minimum_distinct_lessons", "candidates", "authority"],
  "properties": {
    "schema": {"const": "evolutionary-course-artifact-readiness-v1"},
    "as_of": {"type": "string", "minLength": 1},
    "minimum_distinct_lessons": {"type": "integer", "minimum": 3},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lesson_id", "source_name", "source_video_file_id", "source_job_id", "terminal_status", "evidence_refs", "exact_source_identity_verified", "terminal_result_verified", "role_attribution_supported", "course_adapter_report_available", "reviewed_catalog_binding"],
        "properties": {
          "lesson_id": {"type": "string", "minLength": 1},
          "source_name": {"type": "string", "minLength": 1},
          "source_video_file_id": {"type": ["string", "null"]},
          "source_job_id": {"type": ["string", "null"]},
          "terminal_status": {"enum": ["COMPLETED", "FAILED", "INCONCLUSIVE", "NOT_CONFIRMED"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "exact_source_identity_verified": {"type": "boolean"},
          "terminal_result_verified": {"type": "boolean"},
          "role_attribution_supported": {"type": "boolean"},
          "course_adapter_report_available": {"type": "boolean"},
          "reviewed_catalog_binding": {"type": "boolean"}
        }
      }
    },
    "authority": {
      "const": {
        "authority_class": "CANDIDATE_RESEARCH",
        "media_processing_allowed": false,
        "episode_creation_allowed": false,
        "curriculum_activation_allowed": false,
        "student_profile_write_allowed": false,
        "publication_allowed": false
      }
    }
  }
}
