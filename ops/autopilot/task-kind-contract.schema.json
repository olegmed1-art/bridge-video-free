{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge-school.example/schemas/autopilot-task-kind-contract-v1.json",
  "title": "School Autopilot Task Kind Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "version",
    "risk_class",
    "governance_mode",
    "allowed_executors",
    "allowed_transitions",
    "approval_policy",
    "retry_policy",
    "budget_policy",
    "acceptance_criteria",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "maxLength": 1000},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "OWNER_ONLY"]},
    "governance_mode": {"enum": ["LIGHTWEIGHT", "STANDARD", "ASSURED", "INCIDENT"]},
    "allowed_executors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["vercel", "github", "oracle_via_github", "drive", "openai", "owner"]}
    },
    "allowed_transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "event"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "event": {"type": "string"},
          "owner_approval_required": {"type": "boolean", "default": false}
        }
      }
    },
    "approval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for"],
      "properties": {
        "required_for": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "approval_ttl_seconds": {"type": "integer", "minimum": 60},
        "scope_digest_required": {"const": true}
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_external_attempts", "max_model_turns"],
      "properties": {
        "max_external_attempts": {"type": "integer", "minimum": 0, "maximum": 20},
        "max_model_turns": {"type": "integer", "minimum": 0, "maximum": 10},
        "backoff": {"enum": ["none", "fixed", "exponential"]}
      }
    },
    "budget_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_task_limit_usd"],
      "properties": {
        "per_task_limit_usd": {"type": "number", "minimum": 0, "maximum": 1000},
        "critical_model_requires_risk_gate": {"const": true}
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kill_switch_safe", "instructions"],
      "properties": {
        "kill_switch_safe": {"const": true},
        "instructions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
