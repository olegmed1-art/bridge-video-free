# Copy to /opt/bridge-school/assistant-lab/assistant-lab.env and chmod 0600.
# Never commit real credentials.

ASSISTANT_LAB_DATABASE_URL=REQUIRED_NEON_DSN
ASSISTANT_LAB_EXPECTED_DB_USER=assistant_lab_worker_principal
ASSISTANT_LAB_WORKER_ID=oracle-assistant-lab-1

# Keep the queue wakeup low-latency; LISTEN/NOTIFY is primary, timeout is recovery polling.
ASSISTANT_LAB_WAKE_TIMEOUT_SECONDS=2
ASSISTANT_LAB_STALE_AFTER_SECONDS=300

# Hot local DDS3 runtime. DDS3_RUNTIME_TOKEN is loaded separately from
# /opt/bridge-school/dds3-runtime.env by systemd.
ASSISTANT_LAB_DDS3_URL=http://127.0.0.1:8080/v1/compute
ASSISTANT_LAB_DDS3_TIMEOUT_SECONDS=25
