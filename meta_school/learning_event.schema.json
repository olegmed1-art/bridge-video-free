{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "META School Learning Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "student_id", "event_type", "source_id", "provenance", "confidence", "timestamp"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "student_id": {"type": "string", "minLength": 1},
    "topic_id": {"type": ["string", "null"]},
    "skill_id": {"type": ["string", "null"]},
    "event_type": {"enum": ["EXPOSURE", "ASSESSMENT", "DECISION", "ERROR", "SUCCESS", "INTERVENTION", "LATER_OUTCOME"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["LESSON", "VIDEO", "EXERCISE", "HOMEWORK", "TEST", "TOURNAMENT", "DEAL", "COACH", "TEACHER", "OTHER"]},
    "run_id": {"type": ["string", "null"]},
    "artifact_file_id": {"type": ["string", "null"]},
    "deal_id": {"type": ["string", "null"]},
    "evidence_id": {"type": ["string", "null"]},
    "classification": {"type": ["string", "null"]},
    "intervention_id": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}