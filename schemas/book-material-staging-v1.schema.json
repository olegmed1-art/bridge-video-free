{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridge:book-material-staging-v1",
  "title": "Offline book material staging envelope",
  "$comment": "Structural schema only. bridge_contracts.book_material.validate_bundle additionally enforces identity, bounded page indexes, bbox ordering, links, cards, DDS inputs and staging-only policy. Neither validation authorizes publication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "run", "objects", "relations", "legacy_ids", "processing", "publication"],
  "properties": {
    "schema": {"const": "book-material-staging-v1"},
    "processing": {"const": "STAGED"},
    "publication": {"const": "NOT_PUBLISHED"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "edition_id", "rendition_sha256", "title", "locator", "page_count"],
      "properties": {
        "source_id": {"$ref": "#/$defs/text"}, "edition_id": {"$ref": "#/$defs/text"},
        "rendition_sha256": {"$ref": "#/$defs/hash"}, "title": {"$ref": "#/$defs/text"},
        "locator": {"type": "string", "pattern": "^https://[^?#]+$"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "model_version", "prompt_version"],
      "properties": {
        "run_id": {"$ref": "#/$defs/text"}, "model_version": {"$ref": "#/$defs/text"},
        "prompt_version": {"$ref": "#/$defs/text"}
      }
    },
    "legacy_ids": {"type": "object", "propertyNames": {"$ref": "#/$defs/hash"}, "additionalProperties": {"$ref": "#/$defs/text"}},
    "objects": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/record"}},
    "relations": {
      "type": "array", "maxItems": 5000, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from_id", "to_id", "type"],
        "properties": {
          "from_id": {"$ref": "#/$defs/text"}, "to_id": {"$ref": "#/$defs/text"},
          "type": {"enum": ["SUPPORTS", "CONTRADICTS", "EXEMPLIFIES", "COUNTEREXAMPLE_OF", "EXERCISES", "ANSWERS", "DERIVED_FROM", "SUPERSEDES", "AFFECTS"]}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "kind", "anchor", "content", "origin", "verification", "review", "rights", "errata_ids"],
      "properties": {
        "object_id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["POSITION", "EXERCISE", "AUTHOR_ANSWER", "ATOM", "DDS_RESULT", "SINGLE_DUMMY"]},
        "content": {"type": "object"},
        "origin": {"enum": ["AUTHOR", "EDITOR", "INFERENCE"]},
        "verification": {"enum": ["M0", "M1", "M2", "NOT_APPLICABLE"]},
        "review": {"enum": ["NOT_REVIEWED", "NEEDS_REVIEW", "REVIEWED"]},
        "rights": {"enum": ["INTERNAL_ALLOWED", "RESTRICTED", "NEEDS_RIGHTS"]},
        "errata_ids": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "anchor": {
          "type": "object", "additionalProperties": false,
          "required": ["pdf_page_index", "printed_page_label", "bbox", "bbox_units", "segment_sha256", "segment_hash_method"],
          "properties": {
            "pdf_page_index": {"type": "integer", "minimum": 0},
            "printed_page_label": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
            "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}},
            "bbox_units": {"enum": ["NORMALIZED_TOP_LEFT", "PDF_POINTS_TOP_LEFT"]},
            "segment_hash_method": {"enum": ["CROP_BYTES_SHA256", "RENDER_BYTES_SHA256", "NORMALIZED_TEXT_UTF8_SHA256"]},
            "segment_sha256": {"$ref": "#/$defs/hash"}
          }
        }
      }
    }
  }
}
