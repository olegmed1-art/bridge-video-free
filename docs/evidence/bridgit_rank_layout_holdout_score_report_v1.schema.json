{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridge-school/bridgit-rank-layout-holdout-score-report-v1",
  "title": "Bridgit rank-layout frozen unseen holdout score report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "manifest_sha256",
    "gold_bundle_sha256",
    "recognizer_output_bundle_sha256",
    "recognizer_head_sha256",
    "profile_sha256",
    "case_count",
    "source_session_count",
    "gold_visible_targets",
    "accepted_correct",
    "accepted_wrong",
    "rejected_or_unknown",
    "coverage",
    "precision",
    "recall",
    "seat_errors",
    "false_complete_deals",
    "complete_deal_exact_count",
    "per_source_metrics",
    "per_resolution_metrics",
    "per_layout_theme_metrics",
    "per_stress_tag_metrics",
    "thresholds",
    "i2",
    "final_status"
  ],
  "properties": {
    "corpus_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "gold_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "recognizer_output_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "recognizer_head_sha256": { "$ref": "#/$defs/sha256" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "case_count": { "type": "integer", "minimum": 24 },
    "source_session_count": { "type": "integer", "minimum": 4 },
    "gold_visible_targets": { "type": "integer", "minimum": 1 },
    "accepted_correct": { "type": "integer", "minimum": 0 },
    "accepted_wrong": { "type": "integer", "minimum": 0 },
    "rejected_or_unknown": { "type": "integer", "minimum": 0 },
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "precision": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "recall": { "type": "number", "minimum": 0, "maximum": 1 },
    "seat_errors": { "type": "integer", "minimum": 0 },
    "false_complete_deals": { "type": "integer", "minimum": 0 },
    "complete_deal_exact_count": { "type": "integer", "minimum": 0 },
    "per_source_metrics": { "$ref": "#/$defs/metricMap" },
    "per_resolution_metrics": { "$ref": "#/$defs/metricMap" },
    "per_layout_theme_metrics": { "$ref": "#/$defs/metricMap" },
    "per_stress_tag_metrics": { "$ref": "#/$defs/metricMap" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_precision",
        "minimum_recall",
        "maximum_seat_errors",
        "maximum_false_complete_deals",
        "frozen_before_holdout_reveal"
      ],
      "properties": {
        "minimum_precision": { "const": 0.995 },
        "minimum_recall": { "const": 0.95 },
        "maximum_seat_errors": { "const": 0 },
        "maximum_false_complete_deals": { "const": 0 },
        "frozen_before_holdout_reveal": { "const": true }
      }
    },
    "i2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "evaluator_id",
        "input_bundle_sha256",
        "result_sha256",
        "discrepancy_count"
      ],
      "properties": {
        "completed": { "type": "boolean" },
        "evaluator_id": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "input_bundle_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "result_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "discrepancy_count": { "type": "integer", "minimum": 0 }
      }
    },
    "final_status": {
      "type": "string",
      "enum": ["BLOCKED_CORPUS", "HOLDOUT_READY"]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metricBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold_visible_targets",
        "accepted_correct",
        "accepted_wrong",
        "rejected_or_unknown",
        "coverage",
        "precision",
        "recall",
        "seat_errors",
        "false_complete_deals"
      ],
      "properties": {
        "gold_visible_targets": { "type": "integer", "minimum": 0 },
        "accepted_correct": { "type": "integer", "minimum": 0 },
        "accepted_wrong": { "type": "integer", "minimum": 0 },
        "rejected_or_unknown": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "precision": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "seat_errors": { "type": "integer", "minimum": 0 },
        "false_complete_deals": { "type": "integer", "minimum": 0 }
      }
    },
    "metricMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/metricBucket" }
    }
  }
}
