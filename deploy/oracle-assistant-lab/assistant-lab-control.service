[Unit]
Description=Bridge School Assistant Lab Control API v0.1
After=network-online.target assistant-lab-observer.service
Wants=network-online.target
Requires=assistant-lab-observer.service

[Service]
Type=simple
User=assistant-lab-observer
Group=assistant-lab-observer
WorkingDirectory=/opt/bridge-school/bridge-video-free
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=ASSISTANT_LAB_OBSERVER_STATE_ROOT=/opt/bridge-school/assistant-lab-observer
Environment=ASSISTANT_LAB_CONTROL_REGISTRY=/opt/bridge-school/assistant-lab-observer/tool_registry.json
EnvironmentFile=/opt/bridge-school/assistant-lab-observer/control.env
ExecStart=/opt/bridge-school/assistant-lab-observer/.venv/bin/uvicorn assistant_lab.control_api:app --host 127.0.0.1 --port 8765 --workers 1
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/bridge-school/assistant-lab-observer

[Install]
WantedBy=multi-user.target
