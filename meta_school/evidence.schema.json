{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "META School Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "component_id", "component_version", "status_claim", "provenance", "timestamp"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "component_version": {"type": "string", "minLength": 1},
    "status_claim": {"enum": ["DESIGNED", "IMPLEMENTED", "TESTED", "OPERATIONAL"]},
    "source_identity": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "artifact_file_id": {"type": ["string", "null"]},
    "checksum": {"type": ["string", "null"]},
    "test_result": {"enum": ["PASS", "FAIL", "NOT_RUN", "UNKNOWN"]},
    "regression_result": {"enum": ["PASS", "FAIL", "NOT_RUN", "UNKNOWN"]},
    "provenance": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status_claim": {"const": "OPERATIONAL"}}},
      "then": {
        "anyOf": [
          {"required": ["run_id"]},
          {"required": ["artifact_file_id"]}
        ],
        "properties": {
          "test_result": {"const": "PASS"},
          "regression_result": {"const": "PASS"}
        }
      }
    }
  ]
}