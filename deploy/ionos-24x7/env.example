# Copy to /srv/bridge/env/production.env on the IONOS host and chmod 0600.
# NEVER commit real secrets.

# Public HTTPS name routed to the Cube gateway.
COMPUTE_HOST=compute.example.invalid

# Immutable production images. Replace placeholders only with reviewed pinned refs/digests.
GATEWAY_IMAGE=REQUIRED_PINNED_CADDY_IMAGE
DDS3_IMAGE=REQUIRED_PINNED_DDS3_IMAGE
BEN_IMAGE=REQUIRED_PINNED_BEN_IMAGE
AI_WORKER_IMAGE=REQUIRED_PINNED_AI_WORKER_IMAGE

# Runtime authentication. Real values live only on the host secret boundary.
DDS3_RUNTIME_TOKEN=REQUIRED_SECRET
BRIDGE_API_TOKEN=REQUIRED_SECRET

# Existing production Bridge School API. Keep Frankfurt control plane.
BRIDGE_API_BASE_URL=https://bridge-video-free.vercel.app

# Worker polls continuously; current provider-neutral default is 5 seconds.
BRIDGE_WORKER_POLL_SECONDS=5

# Optional administration / observability settings.
TZ=UTC
