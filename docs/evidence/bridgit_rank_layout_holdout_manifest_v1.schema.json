{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridge-school/bridgit-rank-layout-holdout-manifest-v1",
  "title": "Bridgit rank-layout frozen unseen holdout manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "recognizer_head_sha256",
    "profile_sha256",
    "cases"
  ],
  "properties": {
    "corpus_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "recognizer_head_sha256": { "$ref": "#/$defs/sha256" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "cases": {
      "type": "array",
      "minItems": 24,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cardSeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card", "seat"],
      "properties": {
        "card": {
          "type": "string",
          "pattern": "^(A|K|Q|J|T|9|8|7|6|5|4|3|2)(H|C|D|S)$"
        },
        "seat": {
          "type": "string",
          "enum": ["N", "E", "S", "W"]
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_sha256",
        "decoded_pixel_sha256",
        "timestamp_ms",
        "width",
        "height"
      ],
      "properties": {
        "frame_sha256": { "$ref": "#/$defs/sha256" },
        "decoded_pixel_sha256": { "$ref": "#/$defs/sha256" },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "source_session_id",
        "layout_theme_family",
        "tags",
        "frames",
        "gold_visible_card_count",
        "gold_card_seat_pairs",
        "expected_completeness_state",
        "full_layout_forbidden",
        "gold_label_origin",
        "gold_verifier_channel_id",
        "gold_sha256"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "source_session_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "source_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "layout_theme_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "complete",
              "void",
              "blur",
              "compression",
              "overlap",
              "partial_play",
              "deal_transition",
              "pointer_transition",
              "anchor_negative"
            ]
          }
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/frame" }
        },
        "gold_visible_card_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 52
        },
        "gold_card_seat_pairs": {
          "type": "array",
          "maxItems": 52,
          "items": { "$ref": "#/$defs/cardSeat" }
        },
        "expected_completeness_state": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL_PLAY",
            "TRANSITION",
            "AMBIGUOUS",
            "UNKNOWN"
          ]
        },
        "full_layout_forbidden": { "type": "boolean" },
        "gold_label_origin": {
          "type": "string",
          "enum": [
            "HUMAN_DIRECT",
            "SOURCE_TRUTH_WITH_HUMAN_VERIFICATION"
          ]
        },
        "gold_verifier_channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "gold_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
