{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "META School Source Identity Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_id", "person_id", "student_id", "source_type", "source_identity", "status", "provenance", "timestamp"],
  "properties": {
    "mapping_id": {"type": "string", "minLength": 1},
    "person_id": {"type": "string", "minLength": 1},
    "student_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["PORTAL", "ZOOM", "DRIVE", "TOURNAMENT", "EMAIL", "MANUAL", "OTHER"]},
    "source_identity": {"type": "string", "minLength": 1},
    "status": {"enum": ["UNRESOLVED", "CANDIDATE", "VERIFIED", "REJECTED"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verified_by": {"type": ["string", "null"]},
    "provenance": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}