+"""Reject incompatible subset response shapes; no SQL or service is invoked."""
+from datetime import datetime, timezone
+from unittest.mock import Mock
+
+import pytest
+
+from universal_video import subset_worker as api
+
+JOB = "00000000-0000-0000-0000-000000000001"
+LEASE = "00000000-0000-0000-0000-000000000002"
+PRE = "00000000-0000-0000-0000-000000000003"
+POST = "00000000-0000-0000-0000-000000000004"
+NOW = datetime(2026, 10, 13, tzinfo=timezone.utc)
+CLAIM = dict(job_id=JOB, lease_token=LEASE, attempt_count=1, is_canary=True)
+AUTH = dict(status="SOURCE_AND_LEASE_VERIFIED", job_id=JOB, lease_token=LEASE,
+            attempt_count=1, observation_id=PRE, execution_allowed=False,
+            release_allowed=False, database_persistence_allowed=False,
+            canonical_promotion_allowed=False)
+
+
+@pytest.mark.parametrize("flag", ["execution_allowed", "release_allowed",
+                                  "database_persistence_allowed", "canonical_promotion_allowed"])
+@pytest.mark.parametrize("value", [None, True, 0])
+def test_every_authorization_flag_must_be_boolean_false(monkeypatch, flag, value):
+    receipt = {**AUTH, flag: value}
+    if value is None:
+        del receipt[flag]
+    call = Mock(return_value={"authorization": receipt})
+    monkeypatch.setattr(api, "_execute", call)
+    with pytest.raises(api.SubsetWorkerError, match="AUTHORIZATION"):
+        api.SubsetWorkerAdapter(lambda *_a, **_k: PRE).before_work("offline", CLAIM, "worker")
+    call.assert_called_once()
+
+
+def test_boolean_attempt_is_not_an_integer_receipt(monkeypatch):
+    monkeypatch.setattr(api, "_execute", Mock(return_value={"authorization": {**AUTH, "attempt_count": True}}))
+    with pytest.raises(api.SubsetWorkerError, match="AUTHORIZATION"):
+        api.SubsetWorkerAdapter(lambda *_a, **_k: PRE).before_work("offline", CLAIM, "worker")
+
+
