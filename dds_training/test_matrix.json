    {"id":"rule-synthesis","path":"rule_synthesis_selftest.py","suite":"fast","timeout_seconds":30,"description":"Evidence-gated versioned technical rules."},
    {"id":"v23-launch-guard","path":"run_stage_v23_guard_selftest.py","suite":"fast","timeout_seconds":30,"hash_seeds":[0,991],"description":"Legacy compatibility launcher remains fail-closed."},
