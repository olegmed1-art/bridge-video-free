[Unit]
Description=Bridge School Autopilot online pilot observer (shadow only)
After=network-online.target school-autopilot-shadow.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=school-autopilot
Group=school-autopilot
WorkingDirectory=/opt/bridge-school/school-autopilot-online-observer/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=AUTOPILOT_RUNTIME_MODE=SHADOW
Environment=AUTOPILOT_ONLINE_OBSERVER_ID=oracle-online-observer-1
Environment=AUTOPILOT_ONLINE_TICK_SECONDS=1
Environment=AUTOPILOT_ONLINE_MIN_INTERVAL_SECONDS=5
Environment=AUTOPILOT_ONLINE_MAX_TASKS_PER_HOUR=720
Environment=AUTOPILOT_ONLINE_ERROR_THRESHOLD=3
Environment=AUTOPILOT_ONLINE_STATE_DIR=/var/lib/school-autopilot-online-observer
EnvironmentFile=/opt/bridge-school/school-autopilot/autopilot-shadow.env
ExecStart=/opt/bridge-school/school-autopilot/.venv/bin/python -m oracle_autopilot.online_observer
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
Nice=12
CPUQuota=20%
MemoryHigh=128M
MemoryMax=256M
TasksMax=32
StateDirectory=school-autopilot-online-observer
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/school-autopilot-online-observer

[Install]
WantedBy=multi-user.target
