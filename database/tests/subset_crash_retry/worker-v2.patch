+++ b/tests/test_universal_video_subset_worker.py
@@ -0,0 +1,286 @@
+"""Offline worker orchestration tests; no collector, issuer or database service."""
+import json
+import socket
+import sys
+from contextlib import nullcontext
+from datetime import datetime, timezone
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from universal_video import neon_worker as worker
+from universal_video.subset_worker import SubsetWorkerAdapter, SubsetWorkerError
+
+
+JOB = "00000000-0000-0000-0000-000000000001"
+LEASE = "00000000-0000-0000-0000-000000000002"
+PRE = "00000000-0000-0000-0000-000000000003"
+POST = "00000000-0000-0000-0000-000000000004"
+NOW = datetime(2026, 10, 13, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def offline(monkeypatch):
+    item = dict(job_id=JOB, lease_token=LEASE, attempt_count=1, is_canary=True,
+                source_file_id="offline-source", stable_job_key="offline-stable",
+                algorithm_revision=worker.APPROVED_REVISION)
+    state = SimpleNamespace(events=[], calls=[], connections=[], fail=None,
+                            commit_fail=None, receipt_change={}, observations=[PRE, POST])
+
+    def denied(*_a, **_k):
+        raise AssertionError("offline test attempted network access")
+
+    monkeypatch.setattr(socket, "create_connection", denied)
+    monkeypatch.setattr(socket.socket, "connect", denied)
+
+    class Connection:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, error, *_):
+            if error is not None:
+                state.events.append("rollback:" + self.name)
+            elif state.commit_fail == self.name:
+                raise RuntimeError("commit acknowledgement unavailable")
+            else:
+                state.events.append("commit:" + self.name)
+
+        def cursor(self):
+            return Cursor(self)
+
+    class Cursor:
+        def __init__(self, conn):
+            self.conn = conn
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *_):
+            return False
+
+        def execute(self, sql, params):
+            self.name = self.conn.name = sql.split("video_queue.")[1].split("(")[0]
+            self.params = params
+            state.calls.append((self.name, sql, params))
+            state.events.append(self.name)
+            if self.name == state.fail:
+                raise RuntimeError("subset API rejected request")
+
+        def fetchone(self):
+            if self.name == "authorize_subset_attempt":
+                return {"authorization": dict(
+                    {"status": "SOURCE_AND_LEASE_VERIFIED", "job_id": JOB,
+                     "lease_token": LEASE, "attempt_count": 1,
+                     "observation_id": self.params[3],
+                     "execution_allowed": False, "release_allowed": False,
+                     "database_persistence_allowed": False,
+                     "canonical_promotion_allowed": False}, **state.receipt_change)}
+            if self.name == "heartbeat_subset_job":
+                return {"lease_expires_at": NOW}
+            if self.name == "retry_subset_job":
+                return dict(job_status="QUEUED", batch_status="RUNNING", retry_after=NOW)
+            if self.name == "finish_subset_job":
+                batch_status = "CANARY_REVIEW" if self.params[3] == "REVIEW_READY" else "CANARY_BLOCKED"
+                return dict(job_status=self.params[3], batch_status=batch_status, released_jobs=0)
+            raise AssertionError("unexpected SQL: " + self.name)
+
+    def connect(dsn, **kwargs):
+        assert dsn == "postgresql://offline.invalid/test"
+        state.connections.append(kwargs)
+        return Connection()
+
+    dict_row = object()
+    monkeypatch.setitem(sys.modules, "psycopg", SimpleNamespace(connect=connect))
+    monkeypatch.setitem(sys.modules, "psycopg.rows", SimpleNamespace(dict_row=dict_row))
+    state.dict_row = dict_row
+    monkeypatch.setattr(worker, "_processing_timeout", nullcontext)
+    monkeypatch.setattr(worker, "shared_workload_lock", nullcontext)
+    monkeypatch.setattr(worker, "validate_video_runtime", lambda: None)
+    monkeypatch.setattr(worker, "claim_job", Mock(return_value=item))
+    monkeypatch.setattr(worker, "access_token", lambda: "offline-token")
+    monkeypatch.setattr(worker, "verify_claimed_source",
+                        lambda *_: state.events.append("source_read") or {"version": "1"})
+    monkeypatch.setattr(worker, "verify_terminal_output_live",
+                        lambda *_: state.events.append("terminal_readback"))
+
+    class ImmediateHeartbeat(worker._Heartbeat):
+        def __enter__(self):
+            # Exercise the real heartbeat dispatch once without wall-clock waits.
+            self.stop = SimpleNamespace(wait=Mock(side_effect=[False, True]))
+            self._run()
+            return self
+
+        def __exit__(self, *_):
+            pass
+
+    monkeypatch.setattr(worker, "_Heartbeat", ImmediateHeartbeat)
+    for name in ("heartbeat_job", "retry_job", "finish_job"):
+        monkeypatch.setattr(worker, name, Mock(side_effect=AssertionError("legacy fallback")))
+
+    def observe(claim, key, *, boundary):
+        assert claim == item and key == "worker-offline"
+        state.events.append(boundary)
+        return state.observations.pop(0)
+
+    def processor(_):
+        state.events.append("processor")
+        return {"offline_artifact": True}
+
+    state.adapter = SubsetWorkerAdapter(observe)
+    state.item = item
+    state.processor = processor
+    state.run = lambda **kw: worker.process_claim(
+        "postgresql://offline.invalid/test", item, "worker-offline",
+        processor=kw.pop("processor", processor), subset_adapter=state.adapter, **kw)
+    return state
+
+
+def test_one_job_lifecycle_uses_subset_only_and_two_observations(offline):
+    assert worker.process_one_neon(
+        database_url="postgresql://offline.invalid/test", worker_key="worker-offline",
+        processor=offline.processor, subset_adapter=offline.adapter,
+    ) is True
+    assert offline.events == [
+        "heartbeat_subset_job", "commit:heartbeat_subset_job", "before_work",
+        "authorize_subset_attempt", "commit:authorize_subset_attempt", "source_read",
+        "processor", "terminal_readback", "source_read",
+        "before_finish", "finish_subset_job", "commit:finish_subset_job",
+    ]
+    worker.claim_job.assert_called_once_with(
+        "postgresql://offline.invalid/test", "worker-offline", lease_seconds=900,
+        processing_profile=worker.APPROVED_PROFILE, algorithm_revision=worker.APPROVED_REVISION)
+    assert offline.calls[0][2] == (JOB, LEASE, "worker-offline", 900)
+    assert offline.calls[1][2] == (JOB, LEASE, "worker-offline", PRE)
+    finish = offline.calls[2][2]
+    assert finish[:4] == (JOB, LEASE, "worker-offline", "REVIEW_READY")
+    assert finish[5:] == (POST, None)
+    assert json.loads(finish[4])["publication_state"] == "NOT_PUBLISHED"
+    assert json.loads(finish[4])["database_persistence_allowed"] is False
+    assert all(c == dict(row_factory=offline.dict_row, connect_timeout=8,
+                        options="-c statement_timeout=10000 -c lock_timeout=2000",
+                        application_name="universal-video-subset-worker")
+               for c in offline.connections)
+
+
+def test_empty_claim_does_not_request_observations(offline):
+    worker.claim_job.return_value = None
+    assert worker.process_one_neon(
+        database_url="postgresql://offline.invalid/test", worker_key="worker-offline",
+        processor=offline.processor, subset_adapter=offline.adapter,
+    ) is False
+    assert offline.events == []
+
+
+def test_processor_failure_uses_fixed_subset_retry_signature(offline):
+    result = offline.run(processor=Mock(side_effect=RuntimeError("temporary failure")))
+    assert result == dict(job_status="QUEUED", batch_status="RUNNING", retry_after=NOW.isoformat())
+    assert offline.calls[-1][0] == "retry_subset_job"
+    assert offline.calls[-1][2] == (JOB, LEASE, "worker-offline", "UV_ITEM_FAILED", 60)
+    assert "before_finish" not in offline.events
+
+
+def test_content_ambiguity_uses_subset_finish(offline):
+    result = offline.run(processor=Mock(side_effect=RuntimeError("VISUAL_GAP_CHECK_FAILED")))
+    assert result["job_status"] == "AMBIGUOUS"
+    assert offline.calls[-1][2][3] == "AMBIGUOUS"
+    assert offline.calls[-1][2][-2:] == (POST, "UV_CONTENT_AMBIGUOUS")
+
+
+@pytest.mark.parametrize("change", [{"job_id": POST}, {"lease_token": POST},
+                                   {"attempt_count": 2}, {"observation_id": POST},
+                                   {"status": "REJECTED"}])
+def test_wrong_authorization_never_starts_processor(offline, change):
+    offline.receipt_change = change
+    with pytest.raises(SubsetWorkerError, match="AUTHORIZATION_MISMATCH"):
+        offline.run()
+    assert "processor" not in offline.events
+    assert "before_finish" not in offline.events
+
+
+@pytest.mark.parametrize("api", ["authorize_subset_attempt", "heartbeat_subset_job",
+                                 "finish_subset_job", "retry_subset_job"])
+def test_subset_error_has_no_legacy_fallback(offline, api):
+    offline.fail = api
+    processor = Mock(side_effect=RuntimeError("processor failure")) if api == "retry_subset_job" else offline.processor
+    with pytest.raises(RuntimeError):
+        offline.run(processor=processor)
+    if api in ("authorize_subset_attempt", "heartbeat_subset_job"):
+        assert "processor" not in offline.events
+    worker.heartbeat_job.assert_not_called()
+    worker.retry_job.assert_not_called()
+    worker.finish_job.assert_not_called()
+
+
+@pytest.mark.parametrize("api", ["authorize_subset_attempt", "finish_subset_job"])
+def test_commit_error_is_not_reported_as_success(offline, api):
+    offline.commit_fail = api
+    with pytest.raises(RuntimeError, match="commit acknowledgement"):
+        offline.run()
+    if api == "authorize_subset_attempt":
+        assert "processor" not in offline.events
+    assert "commit:" + api not in offline.events
+    worker.finish_job.assert_not_called()
+
+
+@pytest.mark.parametrize("observations,message", [(["invalid"], "ID_INVALID"),
+                                                ([PRE, "invalid"], "ID_INVALID"),
+                                                ([PRE, PRE], "DISTINCT_OBSERVATION")])
+def test_invalid_or_reused_observation_is_rejected(offline, observations, message):
+    offline.observations = observations
+    with pytest.raises(SubsetWorkerError, match=message):
+        offline.run()
+    assert not any(name == "finish_subset_job" for name, _, _ in offline.calls)
+
+
+@pytest.mark.parametrize("boundary", ["before_work", "before_finish"])
+def test_collector_boundary_failure_never_falls_back(offline, boundary):
+    observe = offline.adapter.observation_provider
+
+    def unavailable(claim, key, **kwargs):
+        if kwargs["boundary"] == boundary:
+            raise RuntimeError("collector unavailable")
+        return observe(claim, key, **kwargs)
+
+    offline.adapter.observation_provider = unavailable
+    with pytest.raises(RuntimeError, match="collector unavailable"):
+        offline.run()
+    if boundary == "before_work":
+        assert "processor" not in offline.events and "source_read" not in offline.events
+    assert not any(name == "finish_subset_job" for name, _, _ in offline.calls)
+    worker.retry_job.assert_not_called()
+    worker.finish_job.assert_not_called()
+
+
+def test_missing_provider_and_changed_retry_bound_are_rejected(offline):
+    with pytest.raises(SubsetWorkerError, match="PROVIDER_REQUIRED"):
+        SubsetWorkerAdapter(None)
+    with pytest.raises(SubsetWorkerError, match="RETRY_LIMIT_FIXED"):
+        offline.adapter.retry_job("unused", job_id=JOB, lease_token=LEASE,
+                                  worker_key="worker-offline", error_code="UV_ITEM_FAILED", max_attempts=4)
+    assert offline.calls == []
+
+
+@pytest.mark.parametrize("failure", [False, True])
+def test_default_path_retains_legacy_calls(offline, failure):
+    worker.heartbeat_job.side_effect = None
+    worker.retry_job.side_effect = None
+    worker.retry_job.return_value = {"job_status": "QUEUED"}
+    worker.finish_job.side_effect = None
+    worker.finish_job.return_value = {"job_status": "REVIEW_READY"}
+    processor = Mock(side_effect=RuntimeError("failure")) if failure else offline.processor
+    result = worker.process_claim("legacy-dsn", offline.item, "legacy-worker", processor=processor)
+    worker.heartbeat_job.assert_called_once_with(
+        "legacy-dsn", job_id=JOB, lease_token=LEASE, worker_key="legacy-worker", extend_seconds=900)
+    if failure:
+        assert result == {"job_status": "QUEUED"}
+        worker.retry_job.assert_called_once_with(
+            "legacy-dsn", job_id=JOB, lease_token=LEASE, worker_key="legacy-worker",
+            error_code="UV_ITEM_FAILED", max_attempts=3, base_delay_seconds=60)
+        worker.finish_job.assert_not_called()
+    else:
+        assert result == {"job_status": "REVIEW_READY"}
+        assert worker.finish_job.call_args.kwargs["outcome"] == "REVIEW_READY"
+        worker.retry_job.assert_not_called()
+    assert offline.calls == []
+    assert not any(event.startswith("before_") for event in offline.events)
