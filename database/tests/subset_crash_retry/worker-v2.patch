+"""Independent client replay tests for the exact opt-in adapter candidate.
+
+The real process_one_neon/process_claim/SubsetWorkerAdapter/SQL client execute.
+Scripted transaction outcomes stand in for PostgreSQL; they are NOT DB proof.
+ASR, terminal verification, Drive, Linux locks and timers remain offline doubles.
+"""
+import copy
+from collections import deque
+from contextlib import nullcontext
+from datetime import datetime, timezone
+from types import SimpleNamespace
+from unittest.mock import Mock
+from uuid import UUID
+
+import psycopg
+import pytest
+
+from bridge_output_scoped_idempotency import existing_same_revision_done
+from universal_video import neon_worker as worker
+from universal_video.subset_worker import SubsetWorkerAdapter
+from test_universal_video_batch_retry import stage, obtain
+from test_universal_video_neon_queue import claim as sample_claim
+
+
+def uid(number):
+    return str(UUID(int=number))
+
+
+def claimed(attempt=1):
+    value = sample_claim()
+    value.update(lease_token=uid(100 + attempt), attempt_count=attempt,
+                 output_folder_id="synthetic-output", work_folder_id="synthetic-work")
+    return value
+
+
+def claim_step(value):
+    return dict(name="claim_job", row=value)
+
+
+def authorize(value, observation, *, failure=None):
+    return dict(name="authorize_subset_attempt", failure=failure,
+                row={"authorization": {
+                    "status": "SOURCE_AND_LEASE_VERIFIED", "job_id": value["job_id"],
+                    "lease_token": value["lease_token"], "attempt_count": value["attempt_count"],
+                    "observation_id": observation,
+                    "execution_allowed": False, "release_allowed": False,
+                    "database_persistence_allowed": False, "canonical_promotion_allowed": False,
+                }})
+
+
+def finish(*, failure=None):
+    return dict(name="finish_subset_job", failure=failure,
+                row={"job_status": "REVIEW_READY", "batch_status": "CANARY_REVIEW", "released_jobs": 0})
+
+
+@pytest.fixture
+def client(stage, monkeypatch):
+    steps, observations, calls, events = deque(), deque(), [], []
+
+    class Connection:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, error, *_):
+            if error is not None:
+                events.append((self.step["name"], "rollback"))
+            elif self.step.get("failure") == "before_commit":
+                events.append((self.step["name"], "rollback"))
+                raise ConnectionError("synthetic failure before commit")
+            else:
+                events.append((self.step["name"], "commit"))
+                if self.step.get("failure") == "lost_commit_reply":
+                    raise ConnectionError("synthetic committed, reply lost")
+
+        def cursor(self):
+            connection = self
+
+            class Cursor:
+                def __enter__(self):
+                    return self
+
+                def __exit__(self, *_):
+                    return False
+
+                def execute(self, sql, params):
+                    name = sql.split("video_queue.")[1].split("(")[0]
+                    assert steps, f"unplanned/repeated SQL call: {name}"
+                    connection.step = steps.popleft()
+                    assert name == connection.step["name"]
+                    calls.append((name, params))
+                    if connection.step.get("failure") == "lease_lost":
+                        raise RuntimeError("SUBSET_LEASE_LOST")
+
+                def fetchone(self):
+                    return copy.deepcopy(connection.step["row"])
+
+            return Cursor()
+
+    monkeypatch.setattr(psycopg, "connect", lambda *args, **kwargs: Connection())
+    monkeypatch.setattr(worker, "shared_workload_lock", nullcontext)
+    monkeypatch.setattr(worker, "_processing_timeout", nullcontext)
+    monkeypatch.setattr(worker, "validate_video_runtime", lambda: None)
+    monkeypatch.setattr(worker, "access_token", lambda: "synthetic-token")
+    source_reads = Mock(return_value={"version": "1"})
+    monkeypatch.setattr(worker, "verify_claimed_source", source_reads)
+    monkeypatch.setattr(worker, "verify_terminal_output_live", lambda *args: None)
+    forbidden = Mock(side_effect=AssertionError("legacy fallback"))
+    for name in ("heartbeat_job", "retry_job", "finish_job"):
+        monkeypatch.setattr(worker, name, forbidden)
+
+    def observe(value, key, *, boundary):
+        assert observations, "unplanned observation retry"
+        expected, expected_boundary, observation = observations.popleft()
+        assert value == expected and key == "review-worker" and boundary == expected_boundary
+        events.append((boundary, value["lease_token"], observation))
+        return observation
+
+    control = SimpleNamespace(interrupt=None, processor_calls=0)
+
+    def processor(value):
+        control.processor_calls += 1
+        with worker._stable_environment(value):
+            existing = existing_same_revision_done(SimpleNamespace(base=stage.base), "synthetic-token",
+                                                   value["stable_job_key"], worker.APPROVED_REVISION)
+            if existing is not None:
+                return existing
+            obtain(stage, value["stable_job_key"])
+            if control.interrupt == "checkpoint":
+                raise SystemExit("synthetic crash after checkpoint")
+            if control.interrupt == "technical":
+                raise RuntimeError("synthetic recoverable processor failure")
+            result = {"status": "AI_DONE", "job_id": value["stable_job_key"],
+                      "algorithmRevision": worker.APPROVED_REVISION,
+                      "masterPdf": {"driveId": "synthetic-result-pdf"}}
+            stage.io.upload_json("synthetic-token", "synthetic-output",
+                                 f"AI_DONE_{value['stable_job_key']}.json", result)
+            stage.io.upload_json("synthetic-token", "synthetic-output",
+                                 f"METHODOLOGY_READY_{value['stable_job_key']}.json",
+                                 {"status": "METHODOLOGY_READY", "job_id": value["stable_job_key"],
+                                  "algorithmRevision": worker.APPROVED_REVISION,
+                                  "masterPdfDriveId": "synthetic-result-pdf"})
+            if control.interrupt == "result":
+                raise SystemExit("synthetic crash after result receipts")
+            return result
+
+    adapter = SubsetWorkerAdapter(observe)
+    invoke = lambda: worker.process_one_neon(database_url="postgresql://offline.invalid/review",
+                                             worker_key="review-worker", processor=processor,
+                                             subset_adapter=adapter)
+    yield SimpleNamespace(steps=steps, observations=observations, calls=calls, events=events,
+                          control=control, invoke=invoke, stage=stage, source_reads=source_reads,
+                          adapter=adapter, processor=processor)
+    forbidden.assert_not_called()
+    assert not steps and not observations, "expected client transitions were not reached"
+
+
+def resumed_success(client, value, pre, post):
+    client.steps.extend([claim_step(value), authorize(value, pre), finish(), claim_step(None)])
+    client.observations.extend([(value, "before_work", pre), (value, "before_finish", post)])
+    client.control.interrupt = None
+    client.stage.base = client.stage.restart()
