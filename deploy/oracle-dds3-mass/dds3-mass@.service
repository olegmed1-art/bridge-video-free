[Unit]
Description=Bridge School DDS3 mass validation stage %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dds3-mass
Group=dds3-mass
WorkingDirectory=/opt/bridge-school/bridge-video-free/dds_training
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=DDS3_MASS_STATE_ROOT=/opt/bridge-school/dds3-mass-validation
Environment=BRIDGE_SCHOOL_REPO_ROOT=/opt/bridge-school/bridge-video-free
ExecStart=/opt/bridge-school/bridge-video-free/dds_training/.venv/bin/python /opt/bridge-school/bridge-video-free/dds_training/oracle_mass_dispatch.py --target %i
Nice=10
IOSchedulingClass=idle
CPUQuota=600%
OOMScoreAdjust=250
TimeoutStartSec=infinity
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
PrivateNetwork=true
ReadWritePaths=/opt/bridge-school/dds3-mass-validation

[Install]
WantedBy=multi-user.target
