FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-api.txt ./requirements-api.txt
RUN pip install --no-cache-dir -r requirements-api.txt

COPY bridge_school_api ./bridge_school_api
COPY bridge_contracts ./bridge_contracts
# Complete import closure of the read-only staging adapter; no workers/migrations.
COPY database/video_staging_read.py \
     database/video_staging_lineage.py \
     database/video_candidate_persistence.py \
     database/video_result_persistence.py \
     database/source_identity_persistence.py \
     database/runtime_worker_preflight.py ./database/

EXPOSE 8000

USER 65532:65532
CMD ["uvicorn", "bridge_school_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
